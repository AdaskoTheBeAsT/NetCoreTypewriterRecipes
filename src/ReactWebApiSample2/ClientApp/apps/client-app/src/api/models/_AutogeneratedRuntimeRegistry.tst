${
    using System.Text.RegularExpressions;
    using Typewriter.Extensions.Types;

    Template(Settings settings)
    {
        settings
            .IncludeCurrentProject()
            .IncludeReferencedProjects()
            .UseStringLiteralCharacter('\'')
            .SingleFileMode("typewriter-registry.ts")
            ;
    }

    bool IncludeClass(Class c)
    {
        if (!c.Namespace.StartsWith("ReactWebApiSample"))
        {
            return false;
        }

        if (c.Attributes.FirstOrDefault(p => p.Name == "GenerateFrontendType") == null)
        {
            return false;
        }

        if (c.IsGeneric)
        {
            return false;
        }

        var parent = c.BaseClass;
        if (parent != null && (parent.Name.EndsWith("Controller") || parent.Name.EndsWith("ControllerBase")))
        {
            return false;
        }

        return true;
    }

    bool IncludeRecord(Record r)
    {
        if (!r.Namespace.StartsWith("ReactWebApiSample"))
        {
            return false;
        }

        if (r.Attributes.FirstOrDefault(p => p.Name == "GenerateFrontendType") == null)
        {
            return false;
        }

        if (r.IsGeneric)
        {
            return false;
        }

        var parent = r.BaseRecord;
        if (parent != null && (parent.Name.EndsWith("Controller") || parent.Name.EndsWith("ControllerBase")))
        {
            return false;
        }

        return true;
    }

    string SchemaName(Class c) => c.Name + "Schema";
    string SchemaName(Record r) => r.Name + "Schema";
}
// This file has been AUTOGENERATED by TypeWriter (https://github.com/adaskothebeast/Typewriter).
// Do not modify it.
import { defineTypeRegistry } from '@adaskothebeast/typewriter-schema';
$Classes($IncludeClass)[
import { $SchemaName } from './$Name.schema';
]$Records($IncludeRecord)[
import { $SchemaName } from './$Name.schema';
]

export const apiTypeRegistry = defineTypeRegistry({
$Classes($IncludeClass)[  '$FullName': $SchemaName,
]$Records($IncludeRecord)[  '$FullName': $SchemaName,
]});
