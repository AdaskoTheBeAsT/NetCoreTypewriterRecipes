  "scripts": {
    "build": "nx build client-app",
    "prepare": "cd .. && cd .. && cd .. && husky install src/ReactWebApiSample/ClientApp/.husky",
    "eslint": "eslint -c .eslintrc.json -o ../../../reports/react/eslint-result.json -f json --ext .ts",
    "stylelint": "stylelint \"{apps,libs}/**/*.scss\" --syntax scss",
    "stylelint-check": "stylelint-config-prettier-check",
    "stylelint-report-json": "stylelint \"{apps,libs}/**/*.scss\" --syntax scss -f json>../../../reports/react/stylelint-report.json",
    "stylelint-report-html": "stylelint \"{apps,libs}/**/*.scss\" --custom-formatter=node_modules/stylelint-html-formatter --syntax scss>../../../reports/react/stylelint-report.html",
    "htmlhint": "htmlhint --config .htmlhintrc \"{apps,libs}/**/*.html\"",
    "htmlhint-report-html": "htmlhint --config .htmlhintrc \"{apps,libs}/**/*.html\" --format html&& mv report.html ../../../reports/react/htmlhint-report.html || move report.html ../../../reports/react/htmlhint-report.html",
    "htmlhint-report-txt": "htmlhint --config .htmlhintrc \"{apps,libs}/**/*.html\">../../../reports/react/htmlhint-report.txt",
    "create-icon-sprite": "svg2sprite ./src/assets/svg ./src/assets/sprites/img.svg --stripAttrs id --stripTags title",
    "aud": "yarn-audit-fix"
  },
